{
  "title": "Match Pipeline SLA",
  "uid": "match-sla-001",
  "tags": ["sla", "pipeline", "latency"],
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Match Pipeline P50 / P95 / P99",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 16, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(match_pipeline_duration_seconds_bucket[5m]))", "legendFormat": "P50"},
        {"expr": "histogram_quantile(0.95, rate(match_pipeline_duration_seconds_bucket[5m]))", "legendFormat": "P95"},
        {"expr": "histogram_quantile(0.99, rate(match_pipeline_duration_seconds_bucket[5m]))", "legendFormat": "P99"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"},
        "overrides": [{"matcher": {"id": "byName","options": "P95"},"properties": [{"id": "custom.lineWidth","value": 3}]}]
      }
    },
    {
      "id": 2,
      "title": "SLA Breach Rate (P95 > 30s)",
      "type": "stat",
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.95, rate(match_pipeline_duration_seconds_bucket[5m])) > 30"}],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green","value": 0},{"color": "red","value": 1}]}}}
    },
    {
      "id": 3,
      "title": "Qdrant Vector Search Latency",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, rate(vector_search_latency_seconds_bucket[5m]))", "legendFormat": "Qdrant P95"},
        {"expr": "histogram_quantile(0.99, rate(vector_search_latency_seconds_bucket[5m]))", "legendFormat": "Qdrant P99"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 4,
      "title": "Kafka Consumer Lag",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [{"expr": "kafka_consumer_lag_messages", "legendFormat": "{{topic}}"}]
    }
  ]
}
